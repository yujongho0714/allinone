<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 새 버전 자동 업데이트 (깃허브에서 받아 설치) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <!-- 폰에 설치된 도장 앱 열기 -->
        <package android:name="com.jungdo.attend" />
        <package android:name="kr.jungdo.video" />
        <package android:name="com.android.chrome" />
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="정도 올인원"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="kr.jungdo.allinone.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 다른 앱 화면에서 '메인 메뉴로' 누르면 올인원 앱으로 돌아오기 (jdaio://home) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jdaio" android:host="home" />
            </intent-filter>
        </activity>
    </application>
</manifest>
